{
  "name": "code-editor",
  "version": "1.1.0",
  "description": "程式碼編輯器：專案檔案樹、語法高亮、跳到定義、反編譯、跨檔案搜尋取代、Git 異動清單、差異比對、還原與檔案歷史",
  "main": "backend/index.js",
  "private": true,
  "scripts": {
    "dev": "tooldock-ext dev",
    "debug": "tooldock-ext dev --inspect",
    "validate": "tooldock-ext validate",
    "test": "node --test test/*.test.js",
    "pack": "tooldock-ext pack",
    "install-local": "tooldock-ext install"
  },
  "tooldock": {
    "id": "code-editor",
    "displayName": "程式碼編輯器",
    "description": "像記事本一樣輕巧的程式碼編輯器：建立專案、瀏覽資料夾、語法高亮、多分頁編輯、尋找取代、跳到定義、跨檔案搜尋與取代、反編譯 .class；Git 異動清單、並排／行內差異比對、還原變更與檔案歷史",
    "icon": "💻",
    "engine": "^1.4.0",
    "activationEvents": [],
    "contributes": {
      "views": [
        {
          "id": "codeEditor.main",
          "title": "程式碼編輯器",
          "icon": "💻",
          "entry": "ui/index.html"
        }
      ],
      "commands": [
        {
          "id": "codeEditor.open",
          "title": "程式碼編輯器：開啟"
        },
        {
          "id": "codeEditor.addProject",
          "title": "程式碼編輯器：建立專案…"
        },
        {
          "id": "codeEditor.openFile",
          "title": "程式碼編輯器：開啟檔案…"
        },
        {
          "id": "codeEditor.showChanges",
          "title": "程式碼編輯器：Git 異動清單"
        },
        {
          "id": "codeEditor.search",
          "title": "程式碼編輯器：在專案中搜尋…"
        },
        {
          "id": "codeEditor.keybindings",
          "title": "程式碼編輯器：鍵盤快捷鍵"
        }
      ],
      "configuration": {
        "codeEditor.fontSize": {
          "type": "number",
          "default": 13,
          "title": "字級",
          "description": "像素"
        },
        "codeEditor.tabSize": {
          "type": "number",
          "default": 4,
          "title": "Tab 寬度"
        },
        "codeEditor.insertSpaces": {
          "type": "boolean",
          "default": true,
          "title": "以空白縮排",
          "description": "按 Tab 時插入空白而不是 Tab 字元"
        },
        "codeEditor.wordWrap": {
          "type": "boolean",
          "default": false,
          "title": "自動換行"
        },
        "codeEditor.exclude": {
          "type": "string",
          "default": "node_modules, .git, .svn, .hg, .DS_Store, Thumbs.db, __pycache__",
          "title": "檔案樹排除",
          "description": "逗號分隔，可用 * 萬用字元（例如 *.pyc）"
        },
        "codeEditor.searchExclude": {
          "type": "string",
          "default": "Pods, DerivedData, .expo, .next, .nuxt, .gradle, .dart_tool, .venv, venv, bower_components, coverage, *.min.js, *.min.css, *.map",
          "title": "搜尋排除",
          "description": "跨檔案搜尋與跳到定義不看的檔案或資料夾（檔案樹照常顯示）。逗號分隔，語法同 .gitignore：名稱比對任何一層，含 / 的路徑從專案根目錄算起（例如 docs/build）"
        },
        "codeEditor.searchUseGitignore": {
          "type": "boolean",
          "default": true,
          "title": "搜尋時套用 .gitignore",
          "description": "git 專案裡被 .gitignore 忽略的檔案（例如 build、dist）不搜尋，也不列入跳到定義"
        },
        "codeEditor.gitPath": {
          "type": "string",
          "default": "",
          "title": "git 執行檔",
          "description": "留空時自動尋找"
        },
        "codeEditor.javaPath": {
          "type": "string",
          "default": "",
          "title": "java 執行檔",
          "description": "反編譯 .class 用（java 或 JDK 資料夾）；留空時自動尋找"
        }
      }
    }
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tooldock-cli": "^1.1.0",
    "tooldock-types": "^1.1.0"
  },
  "keywords": [
    "tooldock",
    "code-editor",
    "editor",
    "syntax-highlighting",
    "git",
    "diff",
    "decompiler"
  ]
}
